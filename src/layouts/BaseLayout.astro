---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '@/components/CommandPalette.vue';
import Sidebar from '@/components/Sidebar.astro';
import { tools } from '@/tools/registry';

const paletteTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  description: t.description,
  category: t.category,
  keywords: t.keywords,
  searchTerms: t.searchTerms,
}));

export interface Props {
  title: string;
  description: string;
  /** Path for canonical URL, e.g. "/epoch-converter". Defaults to current. */
  path?: string;
  /** JSON-LD object serialized into the page head. */
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
}

const { title, description, path, jsonLd, ogImage } = Astro.props;
const site = Astro.site ?? new URL('https://tools.maxhogan.dev');
const canonical = new URL(path ?? Astro.url.pathname, site).href;
const og = ogImage ? new URL(ogImage, site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F6F4F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <link
      rel="preload"
      href="/fonts/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Theme + sidebar classes live on <html>, which the view-transition swap
      // (ClientRouter) replaces with the incoming document's bare <html>. So the
      // state is derived in one function, applied before paint on first load,
      // and re-applied on astro:after-swap (fires after the DOM swap, before
      // paint) so navigating never flashes the wrong theme. localStorage holds
      // preferences only — rule 7.
      function applyHtmlState() {
        const html = document.documentElement;
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        html.classList.toggle('dark', dark);

        // Sidebar: open by default at xl and up, closed below. A stored
        // preference overrides that on wide screens.
        const sidebarPref = localStorage.getItem('sidebar');
        html.classList.toggle('sb-closed', sidebarPref === 'closed');
        html.classList.toggle('sb-open', sidebarPref === 'open');
      }
      applyHtmlState();
      // document persists across swaps and this inline script is deduped by the
      // router, so this listener binds exactly once.
      document.addEventListener('astro:after-swap', applyHtmlState);
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <div class="flex">
      <Sidebar />
      <div class="min-w-0 flex-1">
        <slot />
      </div>
    </div>
    <script is:inline>
      // Sidebar toggle. The header button is swapped by ClientRouter on every
      // navigation, so binding a listener to it directly would be lost after the
      // first nav. Instead all wiring is delegated to persistent targets
      // (document, matchMedia) and bound exactly once; element lookups happen at
      // event time. Wide screens toggle the persisted `sb-closed` class; narrow
      // screens toggle the transient drawer.
      (() => {
        const html = document.documentElement;
        const wide = matchMedia('(min-width: 1280px)');
        const button = () => document.getElementById('sidebar-toggle');
        const aside = () => document.getElementById('site-sidebar');
        const isOpen = () =>
          wide.matches ? !html.classList.contains('sb-closed') : html.classList.contains('sb-drawer-open');
        const sync = () => button()?.setAttribute('aria-expanded', isOpen() ? 'true' : 'false');

        function closeDrawer(returnFocus) {
          if (!html.classList.contains('sb-drawer-open')) return;
          html.classList.remove('sb-drawer-open');
          document.body.style.overflow = '';
          sync();
          if (returnFocus) button()?.focus();
        }

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (target.closest && target.closest('#sidebar-toggle')) {
            if (wide.matches) {
              const closed = html.classList.toggle('sb-closed');
              html.classList.toggle('sb-open', !closed);
              localStorage.setItem('sidebar', closed ? 'closed' : 'open');
              sync();
            } else if (html.classList.contains('sb-drawer-open')) {
              closeDrawer(true);
            } else {
              html.classList.add('sb-drawer-open');
              document.body.style.overflow = 'hidden';
              sync();
              // Wait a frame: the panel is not visible (so not focusable) until
              // the class has been applied and styles recomputed.
              requestAnimationFrame(() => aside()?.focus());
            }
          } else if (
            target.closest &&
            (target.closest('#sidebar-close') || target.closest('#sidebar-scrim'))
          ) {
            closeDrawer(true);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeDrawer(true);
        });
        // Crossing the breakpoint must never leave the page scroll locked.
        wide.addEventListener('change', () => {
          closeDrawer(false);
          sync();
        });
        // The button is fresh after every swap; re-sync its aria-expanded.
        document.addEventListener('astro:page-load', sync);
        sync();
      })();
    </script>
    <CommandPalette client:idle tools={paletteTools} />
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
