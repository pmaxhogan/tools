---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { iconFor } from "@/lib/tool-icons";
import { relatedTools } from "@/lib/related-tools";
import { KEYBOARD_FIRST_TOOLS } from "@/lib/shortcuts";
import { categoryByLabel, categoryPath } from "@/tools/categories";
import { tools } from "@/tools/registry";
import type { ToolMeta } from "@/tools/types";
import type { LucideIcon } from "lucide-vue-next";

export interface Props {
  meta: ToolMeta;
}

const { meta } = Astro.props;
const title = `${meta.name}: free, private, in your browser`;
// Server-rendered to static SVG (no client directive, no hydration).
// iconFor is typed to the broad Vue `Component` union, but every entry it can
// return (the curated map plus the Wrench fallback) is actually a lucide
// FunctionalComponent, which is what Astro's JSX check needs to accept it.
const Icon = iconFor(meta.icon) as LucideIcon;

// The breadcrumb category links to its page. registry.test guarantees the label
// resolves, but an unregistered one still has to render, so the link is
// conditional rather than pointing at a bare /category/.
const category = categoryByLabel(meta.category);
const CategoryIcon = category ? (iconFor(category.icon) as LucideIcon) : null;

// Static HTML (no client directive) so the related links are in the page for
// SEO and work with JS disabled, same reasoning as the breadcrumb icon above.
const related = relatedTools(meta, tools).map((t) => ({
  slug: t.slug,
  name: t.name,
  description: t.description,
  Icon: iconFor(t.icon) as LucideIcon,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: meta.name,
      description: meta.description,
      url: new URL(`/${meta.slug}`, Astro.site).href,
      applicationCategory: "UtilityApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "FAQPage",
      mainEntity: meta.copy.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={meta.description}
  path={`/${meta.slug}`}
  jsonLd={jsonLd}
  ogImage={`/og/${meta.slug}.png`}
>
  <SiteHeader />
  <div class="border-b border-[color:var(--brand-hairline)] bg-[image:var(--brand-band)]">
    <div class="mx-auto max-w-3xl px-4 pt-7 pb-8 lg:max-w-5xl xl:max-w-6xl">
      <nav
        aria-label="Breadcrumb"
        class="text-[11px] font-semibold tracking-[0.12em] text-primary uppercase"
      >
        <a href="/" class="text-primary/80 hover:text-primary">Tools</a>
        <span aria-hidden="true"> / </span>
        {
          category && CategoryIcon ? (
            <a
              href={categoryPath(category)}
              class="inline-flex items-center gap-1.5 align-middle text-primary/80 hover:text-primary"
            >
              <CategoryIcon class="size-3.5" stroke-width={2} aria-hidden="true" />
              {meta.category}
            </a>
          ) : (
            <span>{meta.category}</span>
          )
        }
      </nav>
      <div class="mt-2 flex items-center gap-3">
        <span
          class="grid size-11 shrink-0 place-items-center rounded-[12px] bg-[color:var(--accent-soft)] text-[color:var(--primary)]"
          aria-hidden="true"
        >
          <Icon class="size-6" stroke-width={2} />
        </span>
        <h1 class="text-3xl font-semibold tracking-tight">{meta.name}</h1>
      </div>
      <p class="mt-2 max-w-[68ch] text-muted-foreground">{meta.description}</p>
    </div>
  </div>
  <main class="mx-auto max-w-3xl px-4 py-8 lg:max-w-5xl xl:max-w-6xl">
    <div>
      <slot />
    </div>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xs font-semibold tracking-[0.04em] text-muted-foreground uppercase">
            Related tools
          </h2>
          <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((t) => (
              <li>
                <a
                  href={`/${t.slug}`}
                  class="related-tool-card flex h-full gap-3 rounded-[14px] border bg-card p-5 shadow-[var(--sh-sm)]"
                >
                  <span
                    class="grid size-9 shrink-0 place-items-center rounded-[10px] bg-[color:var(--accent-soft)] text-[color:var(--primary)]"
                    aria-hidden="true"
                  >
                    <t.Icon class="size-[18px]" stroke-width={2} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-semibold">{t.name}</span>
                    <span class="mt-1 block text-sm text-muted-foreground">{t.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-12 max-w-[72ch] space-y-3 border-t pt-6 text-sm">
      <details>
        <summary class="cursor-pointer font-medium">What it does</summary>
        <p class="mt-2 text-muted-foreground">{meta.copy.what}</p>
      </details>
      <details>
        <summary class="cursor-pointer font-medium">How to use it</summary>
        <p class="mt-2 text-muted-foreground">{meta.copy.how}</p>
      </details>
      <details>
        <summary class="cursor-pointer font-medium">Why this one</summary>
        <p class="mt-2 text-muted-foreground">{meta.copy.why}</p>
      </details>
      <details>
        <summary class="cursor-pointer font-medium">FAQ</summary>
        <dl class="mt-2 space-y-3">
          {
            meta.copy.faq.map((f) => (
              <div>
                <dt class="font-medium">{f.q}</dt>
                <dd class="mt-1 text-muted-foreground">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </details>
    </section>

    {
      /* Not on a tool whose subject is the keyboard: those pages deliberately
         have no shortcut sheet, so promising one would be wrong. */
      !KEYBOARD_FIRST_TOOLS.has(meta.slug) && (
        <p class="mt-4 max-w-[72ch] text-xs text-muted-foreground">
          Keyboard shortcuts: press <kbd>?</kbd> anywhere on this page to see them.
        </p>
      )
    }

    <footer class="mt-12 max-w-[72ch] border-t pt-6 text-xs text-muted-foreground">
      <p>
        No ads, no accounts, no limits.{" "}
        {meta.privacyNote ?? "Your files and inputs never leave your device."}{" "}
        <a href="https://github.com/pmaxhogan/tools" class="underline hover:text-foreground"
          >MIT licensed</a
        >.
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  /* Same hover treatment as HomeGrid's .tool-card, kept local since this is
     the only static (non-hydrated) card grid on the site. */
  .related-tool-card {
    transition:
      transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
      border-color 120ms ease-out;
  }

  .related-tool-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-md);
    border-color: color-mix(in oklab, var(--primary) 35%, var(--border));
  }

  @media (prefers-reduced-motion: reduce) {
    .related-tool-card {
      transition: border-color 120ms ease-out;
    }

    .related-tool-card:hover {
      transform: none;
    }
  }
</style>
