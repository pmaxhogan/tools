---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import HomeGrid from "@/components/HomeGrid.vue";
import { tools } from "@/tools/registry";

const gridTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  description: t.description,
  category: t.category,
  keywords: t.keywords,
  searchTerms: t.searchTerms,
  icon: t.icon,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "tools.maxhogan.dev",
  url: "https://tools.maxhogan.dev/",
  description: "Fast, private developer tools that run entirely in your browser.",
};
---

<BaseLayout
  title="tools.maxhogan.dev: fast, private developer tools"
  description="Developer and power-user tools that run entirely in your browser. No ads, no accounts, no limits. Your files and inputs never leave your device."
  path="/"
  jsonLd={jsonLd}
  ogImage="/og/site.png"
>
  <SiteHeader />
  <main class="mx-auto max-w-[1140px] px-4 pb-10">
    <section class="relative isolate mx-auto max-w-2xl px-4 pt-16 pb-10 text-center sm:pt-20">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-[image:var(--brand-glow)]"
      >
      </div>
      <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">
        Local-first developer tools
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Tools that respect you</h1>
      <p class="mx-auto mt-4 max-w-xl text-muted-foreground">
        {tools.length} developer and power-user tools that run entirely in your browser. No ads, no accounts,
        no limits. Your files and inputs never leave your device.
      </p>
    </section>

    <div class="mt-8">
      <HomeGrid client:load tools={gridTools} />
    </div>

    <footer class="mt-16 rounded-[18px] border bg-card p-6 text-center shadow-[var(--sh-sm)]">
      <p class="text-sm text-muted-foreground">
        The pledge: no ads, no upsells, no email capture, no watermarks, no artificial limits.
        Shareable state lives in the URL, never on a server.{" "}
        <a
          href="https://github.com/pmaxhogan/tools"
          class="text-primary underline-offset-2 hover:underline">MIT licensed</a
        >.
      </p>
    </footer>
  </main>
</BaseLayout>
