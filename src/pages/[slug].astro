---
import ToolPage from "@/layouts/ToolPage.astro";
import PanelHost from "@/components/tool/PanelHost.vue";
import { tools } from "@/tools/registry";
import type { ToolMeta } from "@/tools/types";

export function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug }, props: { meta: t } }));
}

interface Props {
  meta: ToolMeta;
}

const { meta } = Astro.props;
---

<ToolPage meta={meta}>
  <PanelHost client:load meta={meta} />
</ToolPage>
