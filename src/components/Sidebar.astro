---
import { tools } from '@/tools/registry';
import SidebarNav from '@/components/SidebarNav.vue';

/**
 * Sitewide tool navigation: every tool grouped by category, with live search.
 *
 * The aside shell and its drawer visibility stay pure CSS (a real flex column
 * at xl and up when <html> lacks `sb-closed`, an off-canvas drawer below xl
 * when <html> carries `sb-drawer-open`), both set before paint by BaseLayout.
 * The searchable list itself is a Vue island (SidebarNav) so it can filter,
 * arrow-navigate, and track the active route. It is `transition:persist`ed so
 * its open/closed drawer context and in-progress search survive navigations.
 */

const path = Astro.url.pathname;
const currentSlug = path.replace(/^\/+/, '').replace(/\/+$/, '');

const navTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  description: t.description,
  category: t.category,
  keywords: t.keywords,
  searchTerms: t.searchTerms,
  icon: t.icon,
}));
---

<div
  id="sidebar-scrim"
  class="sidebar-scrim"
  aria-hidden="true"
>
</div>

<aside
  id="site-sidebar"
  class="site-sidebar border-r bg-card"
  aria-label="All tools"
  tabindex="-1"
>
  <div
    class="sticky top-0 z-10 flex items-center justify-between gap-2 border-b bg-card px-4 py-3"
  >
    <h2 class="text-xs font-semibold tracking-[0.04em] text-muted-foreground uppercase">
      All tools
    </h2>
    <button
      id="sidebar-close"
      type="button"
      aria-label="Close tool list"
      class="-mr-1 rounded-md p-1.5 text-muted-foreground transition-colors duration-[120ms] hover:bg-accent hover:text-foreground xl:hidden"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <SidebarNav
    client:load
    transition:persist="sidebar"
    tools={navTools}
    currentSlug={currentSlug}
  />
</aside>

<style>
  .site-sidebar {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Below xl: off-canvas drawer. Kept in the DOM (fixed, so it never takes
     flow space) and hidden with `visibility` so it stays out of the tab
     order and the accessibility tree while closed. */
  @media (max-width: 1279.98px) {
    .site-sidebar {
      position: fixed;
      inset-block: 0;
      left: 0;
      z-index: 50;
      width: 18rem;
      max-width: 85vw;
      visibility: hidden;
      transform: translateX(-100%);
      /* Visibility flips instantly on open and only after the slide-out
         finishes on close, so the panel is focusable the moment it opens. */
      transition:
        transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
        visibility 0s linear 160ms;
    }

    :global(html.sb-drawer-open) .site-sidebar {
      visibility: visible;
      transform: translateX(0);
      box-shadow: var(--sh-lg);
      transition:
        transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
        visibility 0s;
    }

    .sidebar-scrim {
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgba(10, 9, 8, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 160ms ease-out;
    }

    :global(html.sb-drawer-open) .sidebar-scrim {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* xl and up: a real column that pushes the page, sticky and self-scrolling. */
  @media (min-width: 1280px) {
    .site-sidebar {
      position: sticky;
      top: 0;
      align-self: flex-start;
      flex: none;
      width: 17rem;
      height: 100dvh;
    }

    :global(html.sb-closed) .site-sidebar {
      display: none;
    }

    .sidebar-scrim {
      display: none;
    }
  }
</style>
