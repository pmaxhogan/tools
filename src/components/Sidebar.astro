---
import { tools } from "@/tools/registry";
import SidebarNav from "@/components/SidebarNav.vue";
import { SIDEBAR_WIDTH_DEFAULT, SIDEBAR_WIDTH_MAX, SIDEBAR_WIDTH_MIN } from "@/lib/sidebar-width";

/**
 * Sitewide tool navigation: every tool grouped by category, with live search.
 *
 * The aside shell and its drawer visibility stay pure CSS (a real flex column
 * at xl and up when <html> lacks `sb-closed`, an off-canvas drawer below xl
 * when <html> carries `sb-drawer-open`), both set before paint by BaseLayout.
 * The searchable list itself is a Vue island (SidebarNav) so it can filter,
 * arrow-navigate, and track the active route. It is `transition:persist`ed so
 * its open/closed drawer context and in-progress search survive navigations.
 *
 * The aside itself is NOT persisted: it is rebuilt on every view-transition
 * swap, and the island saves and restores its scrollTop around the swap.
 *
 * `#sidebar-resize` is the width drag handle, at xl and up only. It is a
 * sibling of the aside and `position: fixed`, so it never takes flow space and
 * is never clipped by the aside's own scrolling. Its markup is server rendered
 * so the edge exists before hydration; the pointer, keyboard and persistence
 * logic lives in SidebarNav.vue, which survives view transitions and can import
 * the tested helpers in src/lib/sidebar-width.ts.
 */

const path = Astro.url.pathname;
const currentSlug = path.replace(/^\/+/, "").replace(/\/+$/, "");

const navTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  description: t.description,
  category: t.category,
  keywords: t.keywords,
  searchTerms: t.searchTerms,
  icon: t.icon,
}));
---

<div id="sidebar-scrim" class="sidebar-scrim" aria-hidden="true"></div>

<aside id="site-sidebar" class="site-sidebar border-r bg-card" aria-label="All tools" tabindex="-1">
  <div
    id="sidebar-header"
    class="sidebar-header sticky top-0 z-10 flex items-center justify-between gap-2 border-b bg-card px-4"
  >
    <h2 class="text-xs font-semibold tracking-[0.04em] text-muted-foreground uppercase">
      All tools
    </h2>
    <button
      id="sidebar-close"
      type="button"
      aria-label="Close tool list"
      class="-mr-1 rounded-md p-1.5 text-muted-foreground transition-colors duration-[120ms] hover:bg-accent hover:text-foreground xl:hidden"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <SidebarNav client:load transition:persist="sidebar" tools={navTools} currentSlug={currentSlug} />
</aside>

<div
  id="sidebar-resize"
  class="sidebar-resize"
  role="separator"
  tabindex="0"
  aria-orientation="vertical"
  aria-label="Resize the tool list"
  aria-controls="site-sidebar"
  aria-valuemin={SIDEBAR_WIDTH_MIN}
  aria-valuemax={SIDEBAR_WIDTH_MAX}
  aria-valuenow={SIDEBAR_WIDTH_DEFAULT}
>
</div>

<style>
  .site-sidebar {
    /* The header and the island's search box both stick to the top of this
       scroll box. Pinning the header height here lets the search dock sit
       exactly under it, and lets the island measure how much of the scroll
       viewport is covered when it reveals the active tool. */
    --sidebar-header-h: 3.375rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .sidebar-header {
    height: var(--sidebar-header-h);
  }

  /* Resize handle: hidden except at xl and up, where the sidebar is a column. */
  .sidebar-resize {
    display: none;
  }

  /* Below xl: off-canvas drawer. Kept in the DOM (fixed, so it never takes
     flow space) and hidden with `visibility` so it stays out of the tab
     order and the accessibility tree while closed. */
  @media (max-width: 1279.98px) {
    .site-sidebar {
      position: fixed;
      inset-block: 0;
      left: 0;
      z-index: 50;
      width: 18rem;
      max-width: 85vw;
      visibility: hidden;
      transform: translateX(-100%);
      /* Visibility flips instantly on open and only after the slide-out
         finishes on close, so the panel is focusable the moment it opens. */
      transition:
        transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
        visibility 0s linear 160ms;
    }

    :global(html.sb-drawer-open) .site-sidebar {
      visibility: visible;
      transform: translateX(0);
      box-shadow: var(--sh-lg);
      transition:
        transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1),
        visibility 0s;
    }

    .sidebar-scrim {
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgba(10, 9, 8, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 160ms ease-out;
    }

    :global(html.sb-drawer-open) .sidebar-scrim {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* xl and up: a real column that pushes the page, sticky and self-scrolling. */
  @media (min-width: 1280px) {
    /* One resolved width for the column and for where the handle sits, so a
       stored value outside the range can never let the two disagree. */
    .site-sidebar,
    .sidebar-resize {
      --sidebar-w-applied: clamp(
        var(--sidebar-w-min, 14rem),
        var(--sidebar-w, 17rem),
        var(--sidebar-w-max, 28rem)
      );
    }

    .site-sidebar {
      position: sticky;
      top: 0;
      align-self: flex-start;
      flex: none;
      width: var(--sidebar-w-applied);
      height: 100dvh;
    }

    :global(html.sb-closed) .site-sidebar {
      display: none;
    }

    .sidebar-scrim {
      display: none;
    }

    /* A 6px grab edge straddling the sidebar's right border, with the pill
       only showing on hover, on keyboard focus, and while dragging. */
    .sidebar-resize {
      display: block;
      position: fixed;
      inset-block: 0;
      left: var(--sidebar-w-applied);
      z-index: 45;
      width: 6px;
      margin-left: -3px;
      cursor: col-resize;
      touch-action: none;
    }

    :global(html.sb-closed) .sidebar-resize {
      display: none;
    }

    .sidebar-resize::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 3px;
      height: 2.5rem;
      transform: translate(-50%, -50%);
      border-radius: 999px;
      background: var(--brand-hairline);
      opacity: 0;
      transition:
        opacity 120ms ease-out,
        background-color 120ms ease-out;
    }

    .sidebar-resize:hover::before,
    .sidebar-resize:focus-visible::before {
      opacity: 1;
    }

    :global(html.sb-resizing) .sidebar-resize::before {
      opacity: 1;
      background: var(--primary);
    }

    /* Nothing animates while the pointer is driving the width. */
    :global(html.sb-resizing) .site-sidebar,
    :global(html.sb-resizing) .sidebar-resize::before {
      transition: none;
    }
  }
</style>
