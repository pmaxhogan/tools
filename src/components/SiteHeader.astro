---

---

<header
  class="sticky top-0 z-30 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/70"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <div class="flex min-w-0 items-center gap-2">
      <button
        id="sidebar-toggle"
        type="button"
        aria-label="Toggle tool list"
        aria-controls="site-sidebar"
        aria-expanded="false"
        class="-ml-2 rounded-md p-2 text-muted-foreground transition-colors duration-[120ms] hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <a
        href="/"
        aria-label="tools.maxhogan.dev home"
        class="group flex min-w-0 items-center gap-2 truncate font-mono text-sm font-semibold tracking-tight focus-visible:outline-none"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 64 64"
          fill="none"
          class="size-6 shrink-0 text-primary transition-transform duration-[160ms] group-hover:-translate-y-px"
        >
          <line
            x1="36"
            y1="36"
            x2="22"
            y2="22"
            stroke="currentColor"
            stroke-width="8"
            stroke-linecap="round"></line>
          <path
            d="M-15 -7 L15 -5.5 L15 5.5 L-15 7 L-10 0 Z"
            transform="translate(20 20) rotate(-45)"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="3.4"
            stroke-linejoin="round"></path>
          <circle cx="42" cy="42" r="11" fill="none" stroke="currentColor" stroke-width="6.5"
          ></circle>
        </svg>
        <span class="truncate"><span class="text-primary">tools</span>.maxhogan.dev</span>
      </a>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="rounded-md p-2 text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"
          ></path>
        </svg>
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
      <a
        href="https://github.com/pmaxhogan/tools"
        aria-label="Source on GitHub"
        class="rounded-md p-2 text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.97c-3.2.7-3.87-1.54-3.87-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Delegated on document (which persists across ClientRouter swaps) so the
  // toggle keeps working after client-side navigation replaces the button.
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element) || !e.target.closest("#theme-toggle")) return;
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>
