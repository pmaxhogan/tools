{
  // Static Astro build served from ./dist, with a small stateless worker in
  // front of it for the curl API. Only /api and /api/* reach the worker;
  // every other request is served straight off the asset store.
  //
  // Deploy: npm run build && npx wrangler deploy
  "name": "tools",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
  },
  "routes": [
    {
      "pattern": "tools.maxhogan.dev",
      "custom_domain": true,
    },
  ],
  // The signaling relay for Local File Drop: the one sanctioned exception to
  // the no-server rule (PROJECT.md server policy, rule 4). Rooms live in the
  // object's memory only; storage is never written. The SQLite-backed class
  // type is required for new Durable Objects on every plan, but the object
  // never touches it.
  "durable_objects": {
    "bindings": [{ "name": "DROP_ROOMS", "class_name": "DropRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DropRoom"] }],
  // No user content is ever logged (PROJECT.md rule 2), and there is nothing
  // stateful to observe.
  "observability": {
    "enabled": false,
  },
}
