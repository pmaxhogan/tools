{
  "name": "tools",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "lint": "npm run lint:eslint && npm run lint:format && npm run lint:spelling && npm run lint:prose",
    "lint:eslint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:format": "prettier --check . --experimental-cli",
    "lint:spelling": "node scripts/check-spelling.mjs",
    "lint:prose": "node scripts/check-prose.mjs",
    "format": "prettier -w . --experimental-cli",
    "typecheck": "npm run typecheck:astro && npm run typecheck:vue",
    "typecheck:astro": "astro check",
    "typecheck:vue": "vue-tsc --noEmit",
    "check": "node scripts/check.mjs"
  },
  "overrides": {
    "onnxruntime-web": "1.27.0"
  },
